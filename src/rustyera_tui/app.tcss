Screen {
    background: #05070a;
    color: #d8d8d8;
    layers: base menu overlay;
}

#app-root {
    width: 100%;
    height: 100%;
    layer: base;
}

#menu-bar {
    height: 1;
    width: 100%;
    background: #243447;
    color: #f8fafc;
}

.menu-button {
    height: 1;
    min-width: 0;
    width: auto;
    border: none;
    padding: 0 1;
    margin: 0;
    background: #243447;
    color: #f8fafc;
    text-align: left;
    content-align: left middle;
}

.menu-button:hover, .menu-button:focus {
    background: #38bdf8;
    color: #07111f;
    text-style: bold;
}

.dropdown {
    display: none;
    layer: menu;
    dock: top;
    width: 34;
    height: auto;
    background: #1e293b;
    border: solid #38bdf8;
    padding: 0;
}

.dropdown.visible {
    display: block;
}

#file-menu {
    offset: 0 1;
}

#debug-menu {
    offset: 8 1;
}

.menu-item {
    height: 1;
    min-width: 0;
    width: 100%;
    border: none;
    padding: 0 1;
    margin: 0;
    background: #1e293b;
    color: #e2e8f0;
    text-align: left;
    content-align: left middle;
}

.menu-item:hover, .menu-item:focus {
    background: #0ea5e9;
    color: #020617;
}

.menu-item:disabled {
    color: #64748b;
    background: #1e293b;
}

#game-viewport {
    width: 100%;
    height: 1fr;
    overflow-x: auto;
    overflow-y: auto;
    background: #000000;
    scrollbar-color: #475569;
    scrollbar-color-hover: #38bdf8;
}

.game-line {
    width: auto;
    min-width: 100%;
    height: auto;
    min-height: 1;
    padding: 0;
    margin: 0;
    text-wrap: nowrap;
}

.game-line:focus {
    text-style: bold;
}

#separator-line {
    height: 1;
    width: 100%;
    margin: 0;
    padding: 0;
    background: #0f172a;
    color: #64748b;
    border: none;
}

#prompt-row {
    height: 1;
    width: 100%;
    background: #111827;
}

#prompt-label {
    width: 2;
    height: 1;
    background: #111827;
    text-style: bold;
}

#prompt-label.prompt-running {
    color: #a9a9a9;
}

#prompt-label.prompt-running.prompt-running-bright,
#prompt-label.prompt-number {
    color: #f8fafc;
}

#prompt-label.prompt-enter {
    color: #7fffd4;
}

#prompt-label.prompt-other {
    color: #800080;
}

#prompt-label.prompt-error {
    color: #ef4444;
}

#prompt {
    height: 1;
    width: 1fr;
    border: none;
    padding: 0;
    background: #111827;
    color: #f8fafc;
}

#prompt:focus {
    border: none;
}

ModalScreen {
    align: center middle;
    background: #020617 70%;
    layer: overlay;
}

.dialog {
    width: 80%;
    height: 80%;
    max-width: 120;
    background: #111827;
    border: round #38bdf8;
    padding: 1;
}

.wide-dialog {
    width: 90%;
    height: 88%;
}

.confirm-dialog {
    width: 60;
    height: 10;
}

.fatal-dialog {
    width: 84;
    height: 18;
    border: round #ef4444;
}

.fatal-title {
    color: #f87171;
}

#fatal-error {
    height: 1fr;
    padding: 1;
    border: solid #7f1d1d;
    overflow-y: auto;
}

#fatal-export-status {
    height: 2;
    color: #fbbf24;
    padding: 0 1;
}

.fatal-buttons {
    height: 4;
}

#confirm-message {
    height: 1fr;
    padding: 1 0;
}

.dialog-title {
    height: 1;
    color: #7dd3fc;
    text-style: bold;
}

.dialog-buttons {
    height: 3;
    align-horizontal: right;
}

.dialog-buttons Button, .dialog > Button {
    min-width: 10;
    margin: 0 1;
}

#path-tree, #log-view, #console-output, #variable-table {
    height: 1fr;
    border: solid #334155;
}

#fiber-table {
    height: 1fr;
    /* Two border rows, one header row, and at most eight visible data rows. */
    max-height: 11;
    border: solid #334155;
}

#frame-table {
    height: 2fr;
    border: solid #334155;
}

#log-view {
    padding: 0;
    background: #05070a;
    color: #d8d8d8;
}

#log-filter-row {
    height: 3;
    align-vertical: middle;
}

#log-filter-label {
    width: auto;
    margin: 1 1 0 0;
    color: #cbd5e1;
}

#log-level {
    width: 22;
}

#path-value, #console-input {
    height: 3;
}

#variable-status, #stack-status {
    height: 1;
    color: #94a3b8;
}
