@SYSTEM_TITLE
#LOCALSIZE 1
SQL_CONNECT "main", "Data Source=plugins/qol_data.db"
SQL_EXECUTE_NONQUERY "main", "CREATE TABLE IF NOT EXISTS run_count (value INTEGER)"
SQL_EXECUTE_NONQUERY "main", "INSERT INTO run_count VALUES (1)"
RESULT:1 = SQL_EXECUTE_SCALAR_LONG("main", "SELECT COUNT(*) FROM run_count")
SQL_EXECUTE_NONQUERY "main", "DROP TABLE IF EXISTS items"
SQL_EXECUTE_NONQUERY "main", "CREATE TABLE items (id INTEGER PRIMARY KEY, value TEXT, nullable TEXT)"
SQL_P_EXECUTE_NONQUERY "main", "INSERT INTO items VALUES (@0, @1, @2)", "1", "alpha",
SQL_EXECUTE_NONQUERY "main", "BEGIN"
SQL_P_EXECUTE_NONQUERY "main", "INSERT INTO items VALUES (@0, @1, @2)", "2", "rolled-back", "value"
SQL_EXECUTE_NONQUERY "main", "ROLLBACK"
RESULT = SQL_EXECUTE_SCALAR_LONG("main", "SELECT COUNT(*) FROM items")
RESULTS '= SQL_EXECUTE_SCALAR_STRING("main", "SELECT value FROM items WHERE id = 1")
LOCAL = SQL_EXECUTE_READER("main", "SELECT id, nullable FROM items ORDER BY id")
SQL_READER_READ LOCAL
PRINTFORML SNAKE_SQL_SCALAR={RESULT}/%RESULTS%
PRINTFORML SNAKE_SQL_READER={SQL_READER_GET_LONG(LOCAL, 0)}/{SQL_READER_ISNULL(LOCAL, 1)}
PRINTFORML SNAKE_SQL_PERSIST={RESULT:1}
SQL_READER_CLOSE LOCAL
SQL_DISCONNECT "main"
SQL_CONNECT "main", "Data Source=plugins/qol_data.db"
RESULT:1 = SQL_EXECUTE_SCALAR_LONG("main", "SELECT COUNT(*) FROM run_count")
PRINTFORML SNAKE_SQL_REOPEN={RESULT:1}
SQL_DISCONNECT "main"
PRINTL SNAKE_SQL_READY
INPUT
RETURN
