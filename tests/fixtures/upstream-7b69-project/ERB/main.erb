@SYSTEM_TITLE
FLAG:10 = GETNUM(FLAG, "shared")
FLAG:11 = GETNUM(FLAG, "after_duplicate")
SAVEDATA 0, "upstream version 42"
RESULT:1 = 777
CHKDATA 0
FLAG:12 = RESULT
FLAG:13 = RESULT:1
CHKDATA 99
FLAG:14 = RESULT
FLAG:15 = RESULT:1
FLAG:16 = UPSTREAM_CONST_LEN
LOCALS = A😀ｶ
FLAG:17 = STRLENS(LOCALS)
FLAG:18 = STRFIND("😀ｶB", "B")
PRINTFORML UPSTREAM_ALIASES={FLAG:10},{FLAG:11}
PRINTFORML UPSTREAM_CHKDATA={FLAG:12},{FLAG:13},{FLAG:14},{FLAG:15}
PRINTFORML UPSTREAM_STRINGS={FLAG:16},{FLAG:17},{FLAG:18}
PRINTL UPSTREAM_READY
INPUT
IF RESULT == 7
    FLAG:19 = RESULT
    PRINTL UPSTREAM_CONTINUED
    INPUT
ENDIF
RETURN
