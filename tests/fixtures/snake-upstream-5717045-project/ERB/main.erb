@SYSTEM_TITLE
SAVEDATA 0, "snake upstream version 42"
RESULT:1 = 777
CHKDATA 0
FLAG:12 = RESULT
FLAG:13 = RESULT:1
CHKDATA 99
FLAG:14 = RESULT
FLAG:15 = RESULT:1
FLAG:16 = UPSTREAM_CONST_LEN
LOCALS = A😀ｶ
FLAG:17 = STRLENS(LOCALS)
FLAG:18 = STRFIND("😀ｶB", "B")
LOCAL = 0
FLAG:20 = RAND:LOCAL
FLAG:21 = RAND(5, 5)
FLAG:22 = GETNUM(ABL, "erd_name")
FLAG:23 = GETNUM(ABL, "csv_name")
FLAG:24 = GETNUM(PALAM, "shared_stem")
FLAG:25 = ITEMPRICE:0
FLAG:26 = ITEMPRICE:1
FLAG:27 = GETNUM(ITEM, "erd_item")
PRINTFORML SNAKE_UPSTREAM_CHKDATA={FLAG:12},{FLAG:13},{FLAG:14},{FLAG:15}
PRINTFORML SNAKE_UPSTREAM_STRINGS={FLAG:16},{FLAG:17},{FLAG:18}
PRINTFORML SNAKE_UPSTREAM_RAND={FLAG:20},{FLAG:21}
PRINTFORML SNAKE_UPSTREAM_ERD={FLAG:22},{FLAG:23},{FLAG:24},{FLAG:25},{FLAG:26},{FLAG:27}
PRINTL SNAKE_UPSTREAM_READY
INPUT
IF RESULT == 7
    FLAG:19 = RESULT
    LOCAL = -1
    FLAG:28 = RAND:LOCAL
    FLAG:29 = RAND(8, 2)
    PRINTFORML SNAKE_UPSTREAM_RAND_CONTINUED={FLAG:28},{FLAG:29}
    PRINTL SNAKE_UPSTREAM_CONTINUED
    INPUT
ENDIF
RETURN
