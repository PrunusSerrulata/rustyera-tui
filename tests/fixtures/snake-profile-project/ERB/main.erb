@SYSTEM_TITLE
FLAG:0 = 37
PRINTL SNAKE_PROFILE_INFRASTRUCTURE_READY
PRINTFORML SNAKE_PROFILE_INITIAL={FLAG:0}
INPUT
IF RESULT == 1
    SAVEDATA 0, "snake profile roundtrip"
    PRINTL SNAKE_PROFILE_SAVE_WRITTEN
    FLAG:0 = 99
    PRINTFORML SNAKE_PROFILE_SAVE_CHANGED={FLAG:0}
    INPUT
    LOADDATA 0
    PRINTL SNAKE_PROFILE_LOAD_UNEXPECTED_RETURN
ELSE
    FLAG:0 += RESULT
    PRINTFORML SNAKE_PROFILE_CONTINUED={FLAG:0}
    INPUT
ENDIF
RETURN

@SYSTEM_LOADEND
PRINTFORML SNAKE_PROFILE_SAVE_RESTORED={FLAG:0}
RETURN

@EVENTLOAD
RETURN

@SHOW_SHOP
PRINTL SNAKE_PROFILE_SAVE_ROUNDTRIP_READY
INPUT
RETURN
